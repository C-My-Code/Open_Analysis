{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "oa-error/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured error or warning: stable ``code``, one-sentence ``message``, JSON-Pointer\n``path``,\none actionable ``hint`` and code-specific ``details``.",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Code-specific data, documented per code (candidates, estimate, next_offset).",
      "title": "Details",
      "type": "object"
    },
    "hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hint"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorInfo",
  "type": "object"
}
