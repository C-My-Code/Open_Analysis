{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0. Generated by 'python -m oa_model.schemas'.",
  "$defs": {
    "DiffPair": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Pair id, e.g. 'dp:USB_D'.",
          "examples": [
            "dp:USB_D"
          ],
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "n_net": {
          "description": "Name of the negative net.",
          "minLength": 1,
          "title": "N Net",
          "type": "string"
        },
        "origin": {
          "description": "How the pair was determined (extensible).",
          "enum": [
            "naming",
            "netclass",
            "source_explicit",
            "user"
          ],
          "title": "Origin",
          "type": "string"
        },
        "p_net": {
          "description": "Name of the positive net.",
          "minLength": 1,
          "title": "P Net",
          "type": "string"
        },
        "target_z_diff": {
          "anyOf": [
            {
              "description": "Resistance or impedance in ohms. Strings such as '50ohm' parse.",
              "gt": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target differential impedance, ohms.",
          "title": "Target Z Diff"
        }
      },
      "required": [
        "id",
        "p_net",
        "n_net",
        "origin"
      ],
      "title": "DiffPair",
      "type": "object"
    },
    "NetSelector": {
      "additionalProperties": false,
      "description": "Selects nets by name glob, regex, net class or diff pair: the union of all criteria\nminus `exclude`. An empty selector selects nothing.",
      "properties": {
        "diff_pairs": {
          "default": [],
          "description": "Diff pair ids.",
          "items": {
            "description": "Stable unique item id: 'k:<uuid>' (KiCad), 'i:<id>' (IPC-2581), 'h:<hash>'.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Diff Pairs",
          "type": "array"
        },
        "exclude": {
          "default": [],
          "description": "Net name globs to remove.",
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "kinds": {
          "default": [],
          "description": "Net kinds.",
          "items": {
            "enum": [
              "signal",
              "power",
              "ground"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "names": {
          "default": [],
          "description": "Net name globs: 'USB_*'.",
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "net_classes": {
          "default": [],
          "description": "Net class names.",
          "items": {
            "type": "string"
          },
          "title": "Net Classes",
          "type": "array"
        },
        "regex": {
          "default": [],
          "description": "Regexes matched against the whole name.",
          "items": {
            "type": "string"
          },
          "title": "Regex",
          "type": "array"
        }
      },
      "title": "NetSelector",
      "type": "object"
    },
    "PowerIntent": {
      "additionalProperties": false,
      "properties": {
        "i_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum current, amps.",
          "title": "I Max"
        },
        "net": {
          "description": "Power net name.",
          "minLength": 1,
          "title": "Net",
          "type": "string"
        },
        "return_net": {
          "default": "GND",
          "description": "Return net name.",
          "minLength": 1,
          "title": "Return Net",
          "type": "string"
        },
        "tolerance": {
          "default": 0.05,
          "description": "Voltage tolerance fraction.",
          "title": "Tolerance",
          "type": "number"
        },
        "v_nominal": {
          "description": "Nominal voltage, volts.",
          "title": "V Nominal",
          "type": "number"
        }
      },
      "required": [
        "net",
        "v_nominal"
      ],
      "title": "PowerIntent",
      "type": "object"
    },
    "SignalIntent": {
      "additionalProperties": false,
      "properties": {
        "f_max": {
          "anyOf": [
            {
              "description": "Frequency in hertz, > 0. Strings such as '1GHz' parse.",
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest frequency of interest, Hz; default 0.35 / rise_time.",
          "title": "F Max"
        },
        "high_speed": {
          "default": true,
          "description": "Treat as a high-speed net.",
          "title": "High Speed",
          "type": "boolean"
        },
        "io": {
          "default": false,
          "description": "Leaves the board (EMI).",
          "title": "Io",
          "type": "boolean"
        },
        "reference_nets": {
          "default": [],
          "description": "Allowed reference nets; empty = any ground/power.",
          "items": {
            "description": "Net name, unique per board (the net's key). Never an index.",
            "minLength": 1,
            "type": "string"
          },
          "title": "Reference Nets",
          "type": "array"
        },
        "rise_time": {
          "anyOf": [
            {
              "description": "Time in seconds. Strings such as '100ps' parse.",
              "gt": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "10-90 % rise time, seconds.",
          "title": "Rise Time"
        },
        "select": {
          "$ref": "#/$defs/NetSelector",
          "description": "Nets this entry applies to."
        },
        "target_z_diff": {
          "anyOf": [
            {
              "description": "Resistance or impedance in ohms. Strings such as '50ohm' parse.",
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Differential ohms.",
          "title": "Target Z Diff"
        },
        "target_z_se": {
          "anyOf": [
            {
              "description": "Resistance or impedance in ohms. Strings such as '50ohm' parse.",
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Single-ended ohms.",
          "title": "Target Z Se"
        },
        "z_tolerance": {
          "default": 0.1,
          "description": "Impedance tolerance fraction.",
          "title": "Z Tolerance",
          "type": "number"
        }
      },
      "required": [
        "select"
      ],
      "title": "SignalIntent",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diff_pairs_add": {
      "default": [],
      "description": "Extra diff pairs.",
      "items": {
        "$ref": "#/$defs/DiffPair"
      },
      "title": "Diff Pairs Add",
      "type": "array"
    },
    "diff_pairs_remove": {
      "default": [],
      "description": "Ids of board diff pairs to ignore.",
      "items": {
        "description": "Stable unique item id: 'k:<uuid>' (KiCad), 'i:<id>' (IPC-2581), 'h:<hash>'.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Diff Pairs Remove",
      "type": "array"
    },
    "ground_nets": {
      "default": [],
      "description": "Explicit ground nets; default heuristic GND*, VSS*, AGND, ...",
      "items": {
        "description": "Net name, unique per board (the net's key). Never an index.",
        "minLength": 1,
        "type": "string"
      },
      "title": "Ground Nets",
      "type": "array"
    },
    "power": {
      "default": [],
      "description": "Power rails.",
      "items": {
        "$ref": "#/$defs/PowerIntent"
      },
      "title": "Power",
      "type": "array"
    },
    "schema": {
      "const": "oa-intent/1",
      "default": "oa-intent/1",
      "description": "Schema tag; always 'oa-intent/1'.",
      "title": "Schema",
      "type": "string"
    },
    "signals": {
      "default": [],
      "description": "Later entries override earlier ones per net.",
      "items": {
        "$ref": "#/$defs/SignalIntent"
      },
      "title": "Signals",
      "type": "array"
    }
  },
  "title": "DesignIntent",
  "type": "object"
}
