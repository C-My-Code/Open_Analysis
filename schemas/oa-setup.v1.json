{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0. Generated by 'python -m oa_model.schemas'.",
  "$defs": {
    "CoaxPort": {
      "additionalProperties": false,
      "properties": {
        "dielectric": {
          "default": "PTFE",
          "description": "Material name between conductors.",
          "title": "Dielectric",
          "type": "string"
        },
        "inner_radius": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inner radius, metres; None = drill radius.",
          "title": "Inner Radius"
        },
        "kind": {
          "const": "coax",
          "default": "coax",
          "description": "Discriminator tag; always 'coax'.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Port name, unique in the setup.",
          "title": "Name",
          "type": "string"
        },
        "outer_radius": {
          "description": "Outer conductor radius, metres.",
          "minimum": 0.0,
          "title": "Outer Radius",
          "type": "number"
        },
        "pad": {
          "$ref": "#/$defs/PadTerminal",
          "description": "Connector centre pin pad."
        },
        "z0": {
          "default": 50.0,
          "description": "Reference impedance, ohms.",
          "title": "Z0",
          "type": "number"
        }
      },
      "required": [
        "name",
        "pad",
        "outer_radius"
      ],
      "title": "CoaxPort",
      "type": "object"
    },
    "JsonValue": {},
    "LumpedPort": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lumped",
          "default": "lumped",
          "description": "Discriminator tag; always 'lumped'.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Port name, unique in the setup.",
          "title": "Name",
          "type": "string"
        },
        "negative": {
          "description": "Negative terminal.",
          "discriminator": {
            "mapping": {
              "nearest_reference": "#/$defs/NearestReferenceTerminal",
              "pad": "#/$defs/PadTerminal",
              "pin_group": "#/$defs/PinGroupTerminal",
              "point": "#/$defs/PointTerminal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PadTerminal"
            },
            {
              "$ref": "#/$defs/PinGroupTerminal"
            },
            {
              "$ref": "#/$defs/PointTerminal"
            },
            {
              "$ref": "#/$defs/NearestReferenceTerminal"
            }
          ],
          "title": "Negative"
        },
        "positive": {
          "description": "Positive terminal.",
          "discriminator": {
            "mapping": {
              "nearest_reference": "#/$defs/NearestReferenceTerminal",
              "pad": "#/$defs/PadTerminal",
              "pin_group": "#/$defs/PinGroupTerminal",
              "point": "#/$defs/PointTerminal"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PadTerminal"
            },
            {
              "$ref": "#/$defs/PinGroupTerminal"
            },
            {
              "$ref": "#/$defs/PointTerminal"
            },
            {
              "$ref": "#/$defs/NearestReferenceTerminal"
            }
          ],
          "title": "Positive"
        },
        "z0": {
          "default": 50.0,
          "description": "Reference impedance, ohms.",
          "title": "Z0",
          "type": "number"
        }
      },
      "required": [
        "name",
        "positive",
        "negative"
      ],
      "title": "LumpedPort",
      "type": "object"
    },
    "NearestReferenceTerminal": {
      "additionalProperties": false,
      "description": "Nearest reference-plane copper under or around the positive terminal.",
      "properties": {
        "kind": {
          "const": "nearest_reference",
          "default": "nearest_reference",
          "description": "Discriminator tag; always 'nearest_reference'.",
          "title": "Kind",
          "type": "string"
        },
        "nets": {
          "default": [],
          "description": "Restrict to nets; empty = any ground.",
          "items": {
            "description": "Net name, unique per board (the net's key). Never an index.",
            "minLength": 1,
            "type": "string"
          },
          "title": "Nets",
          "type": "array"
        },
        "search_radius": {
          "default": 0.002,
          "description": "Search radius, metres.",
          "minimum": 0.0,
          "title": "Search Radius",
          "type": "number"
        }
      },
      "title": "NearestReferenceTerminal",
      "type": "object"
    },
    "PadTerminal": {
      "additionalProperties": false,
      "description": "Either a pad id, or a refdes plus pin number.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refdes, with `pin`.",
          "title": "Component"
        },
        "kind": {
          "const": "pad",
          "default": "pad",
          "description": "Discriminator tag; always 'pad'.",
          "title": "Kind",
          "type": "string"
        },
        "pad": {
          "anyOf": [
            {
              "description": "Stable unique item id: 'k:<uuid>' (KiCad), 'i:<id>' (IPC-2581), 'h:<hash>'.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pad id.",
          "title": "Pad"
        },
        "pin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin number on the component.",
          "title": "Pin"
        }
      },
      "title": "PadTerminal",
      "type": "object"
    },
    "PinGroupTerminal": {
      "additionalProperties": false,
      "description": "All pads of a component on the given net(s), shorted into one terminal.",
      "properties": {
        "component": {
          "description": "Refdes.",
          "title": "Component",
          "type": "string"
        },
        "kind": {
          "const": "pin_group",
          "default": "pin_group",
          "description": "Discriminator tag; always 'pin_group'.",
          "title": "Kind",
          "type": "string"
        },
        "nets": {
          "description": "Net names whose pads are grouped.",
          "items": {
            "description": "Net name, unique per board (the net's key). Never an index.",
            "minLength": 1,
            "type": "string"
          },
          "title": "Nets",
          "type": "array"
        },
        "pins": {
          "default": [],
          "description": "Pin numbers; empty = all on the nets.",
          "items": {
            "type": "string"
          },
          "title": "Pins",
          "type": "array"
        }
      },
      "required": [
        "component",
        "nets"
      ],
      "title": "PinGroupTerminal",
      "type": "object"
    },
    "PlanePairPort": {
      "additionalProperties": false,
      "description": "PI/EMI port between two planes at a location.",
      "properties": {
        "kind": {
          "const": "plane_pair",
          "default": "plane_pair",
          "description": "Discriminator tag; always 'plane_pair'.",
          "title": "Kind",
          "type": "string"
        },
        "lower_layer": {
          "description": "Lower plane layer id.",
          "examples": [
            "L1",
            "D2",
            "MT"
          ],
          "pattern": "^(L[1-9][0-9]*|D[1-9][0-9]*|MT|MB)$",
          "title": "Lower Layer",
          "type": "string"
        },
        "name": {
          "description": "Port name, unique in the setup.",
          "title": "Name",
          "type": "string"
        },
        "position": {
          "description": "Board-frame (x, y), metres.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "radius": {
          "default": 0.00015,
          "description": "Port radius, metres.",
          "minimum": 0.0,
          "title": "Radius",
          "type": "number"
        },
        "upper_layer": {
          "description": "Upper plane layer id.",
          "examples": [
            "L1",
            "D2",
            "MT"
          ],
          "pattern": "^(L[1-9][0-9]*|D[1-9][0-9]*|MT|MB)$",
          "title": "Upper Layer",
          "type": "string"
        }
      },
      "required": [
        "name",
        "position",
        "upper_layer",
        "lower_layer"
      ],
      "title": "PlanePairPort",
      "type": "object"
    },
    "PointTerminal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "point",
          "default": "point",
          "description": "Discriminator tag; always 'point'.",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "description": "Conductor layer id.",
          "examples": [
            "L1",
            "D2",
            "MT"
          ],
          "pattern": "^(L[1-9][0-9]*|D[1-9][0-9]*|MT|MB)$",
          "title": "Layer",
          "type": "string"
        },
        "net": {
          "anyOf": [
            {
              "description": "Net name, unique per board (the net's key). Never an index.",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional assertion; resolution fails if copper there differs.",
          "title": "Net"
        },
        "position": {
          "description": "Board-frame (x, y), metres.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "position",
        "layer"
      ],
      "title": "PointTerminal",
      "type": "object"
    },
    "TraceEndPort": {
      "additionalProperties": false,
      "description": "Wave or TL port where a trace crosses the extraction-region boundary.",
      "properties": {
        "deembed": {
          "default": 0.0,
          "description": "Reference-plane shift, metres.",
          "minimum": 0.0,
          "title": "Deembed",
          "type": "number"
        },
        "kind": {
          "const": "trace_end",
          "default": "trace_end",
          "description": "Discriminator tag; always 'trace_end'.",
          "title": "Kind",
          "type": "string"
        },
        "modes": {
          "default": "single",
          "description": "Modes to excite.",
          "enum": [
            "single",
            "differential",
            "both"
          ],
          "title": "Modes",
          "type": "string"
        },
        "name": {
          "description": "Port name, unique in the setup.",
          "title": "Name",
          "type": "string"
        },
        "nets": {
          "description": "1 net (single-ended) or 2 nets (differential, P first).",
          "items": {
            "description": "Net name, unique per board (the net's key). Never an index.",
            "minLength": 1,
            "type": "string"
          },
          "title": "Nets",
          "type": "array"
        },
        "side": {
          "default": "auto",
          "description": "Region face to place the port on.",
          "enum": [
            "xmin",
            "xmax",
            "ymin",
            "ymax",
            "auto"
          ],
          "title": "Side",
          "type": "string"
        },
        "z0": {
          "anyOf": [
            {
              "description": "Resistance or impedance in ohms. Strings such as '50ohm' parse.",
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ohms; None = renormalize to the computed line impedance.",
          "title": "Z0"
        }
      },
      "required": [
        "name",
        "nets"
      ],
      "title": "TraceEndPort",
      "type": "object"
    },
    "Waiver": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who waived it.",
          "title": "Author"
        },
        "expires": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date after which it lapses.",
          "title": "Expires"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact violation fingerprint.",
          "title": "Fingerprint"
        },
        "nets": {
          "default": [],
          "description": "Net name globs.",
          "items": {
            "type": "string"
          },
          "title": "Nets",
          "type": "array"
        },
        "reason": {
          "description": "Why this is waived (required).",
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule id, optionally with `nets`.",
          "title": "Rule Id"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Waiver",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "description": "Analysis kind, e.g. 'em.sparams'.",
      "title": "Analysis",
      "type": "string"
    },
    "config": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Analysis-specific configuration, validated against Analysis.Config at load.",
      "title": "Config",
      "type": "object"
    },
    "description": {
      "default": "",
      "description": "Free text.",
      "title": "Description",
      "type": "string"
    },
    "name": {
      "description": "Unique in the project; defaults to the file stem.",
      "title": "Name",
      "type": "string"
    },
    "ports": {
      "default": [],
      "description": "Ports for EM / PI analyses.",
      "items": {
        "discriminator": {
          "mapping": {
            "coax": "#/$defs/CoaxPort",
            "lumped": "#/$defs/LumpedPort",
            "plane_pair": "#/$defs/PlanePairPort",
            "trace_end": "#/$defs/TraceEndPort"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/LumpedPort"
          },
          {
            "$ref": "#/$defs/TraceEndPort"
          },
          {
            "$ref": "#/$defs/CoaxPort"
          },
          {
            "$ref": "#/$defs/PlanePairPort"
          }
        ]
      },
      "title": "Ports",
      "type": "array"
    },
    "schema": {
      "const": "oa-setup/1",
      "description": "Schema tag.",
      "title": "Schema",
      "type": "string"
    },
    "waivers": {
      "default": [],
      "description": "ERC waivers.",
      "items": {
        "$ref": "#/$defs/Waiver"
      },
      "title": "Waivers",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "name",
    "analysis",
    "config"
  ],
  "title": "AnalysisSetup",
  "type": "object"
}
