{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "allow_external": {
          "default": true,
          "description": "Whether external solver binaries may run.",
          "title": "Allow External",
          "type": "boolean"
        },
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allow-list of logical tool names; None = all configured tools.",
          "title": "Allowed Tools"
        },
        "max_cpus": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum concurrent worker processes/threads [1].",
          "title": "Max Cpus"
        },
        "max_memory_gb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak resident memory across workers and external processes [GB].",
          "title": "Max Memory Gb"
        },
        "max_runtime_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall-clock limit for the whole job [s].",
          "title": "Max Runtime S"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "oa.cmd.analysis_run.in/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Run any registered analysis from a stored setup or an inline config.",
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Analysis kind; required with `config`, ignored with `setup`.",
      "title": "Analysis"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/Budget"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-call budget, clamped to the ceiling."
    },
    "config": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inline analysis config (validated against the analysis Config).",
      "title": "Config"
    },
    "dry_run": {
      "default": false,
      "description": "Estimate only; start no job.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "executor": {
      "default": "process",
      "description": "Where tasks run.",
      "enum": [
        "inline",
        "process"
      ],
      "title": "Executor",
      "type": "string"
    },
    "ports": {
      "default": [],
      "description": "Inline ports for EM and PI analyses (oa-setup/1 `ports`).",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Ports",
      "type": "array"
    },
    "project_id": {
      "description": "Project id returned by board.open.",
      "title": "Project Id",
      "type": "string"
    },
    "setup": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of a stored setup (oa/setups/NAME.yaml).",
      "title": "Setup"
    },
    "wait_s": {
      "default": 0.0,
      "description": "Wait up to this long for the job to finish [s]; 0 returns a handle at once.",
      "maximum": 3600,
      "minimum": 0,
      "title": "Wait S",
      "type": "number"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "RunAnalysisIn",
  "type": "object"
}
