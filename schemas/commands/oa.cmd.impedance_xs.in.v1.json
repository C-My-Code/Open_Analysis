{
  "$defs": {
    "CannonballHuray": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cannonball_huray",
          "default": "cannonball_huray",
          "description": "Discriminator tag; always 'cannonball_huray'.",
          "title": "Kind",
          "type": "string"
        },
        "rz": {
          "description": "Datasheet Rz (10-point height), metres.",
          "minimum": 0.0,
          "title": "Rz",
          "type": "number"
        }
      },
      "required": [
        "rz"
      ],
      "title": "CannonballHuray",
      "type": "object"
    },
    "ConstantDkDf": {
      "additionalProperties": false,
      "description": "Constant Dk/Df at f_ref. NOT causal; physics converts it to Djordjevic-Sarkar.",
      "properties": {
        "df": {
          "description": "Loss tangent (dimensionless).",
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Df",
          "type": "number"
        },
        "dk": {
          "description": "Relative permittivity (dimensionless), >= 1.",
          "minimum": 1.0,
          "title": "Dk",
          "type": "number"
        },
        "f_ref": {
          "default": 1000000000.0,
          "description": "Frequency (Hz) at which dk/df were measured.",
          "exclusiveMinimum": 0.0,
          "title": "F Ref",
          "type": "number"
        },
        "kind": {
          "const": "constant",
          "default": "constant",
          "description": "Discriminator tag; always 'constant'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dk",
        "df"
      ],
      "title": "ConstantDkDf",
      "type": "object"
    },
    "CrossSection": {
      "additionalProperties": false,
      "description": "2D transmission-line cross-section. Canonical form: u=0 at the midpoint of the signal\nconductors' bounding box and z=0 at the lowest material boundary.",
      "properties": {
        "background_dk": {
          "default": 1.0,
          "description": "Relative permittivity outside every dielectric (air).",
          "minimum": 1.0,
          "title": "Background Dk",
          "type": "number"
        },
        "conductors": {
          "description": "Conductors; the ORDER of signal conductors defines matrix index order.",
          "items": {
            "$ref": "#/$defs/XsConductor"
          },
          "title": "Conductors",
          "type": "array"
        },
        "dielectrics": {
          "description": "Dielectric regions.",
          "items": {
            "$ref": "#/$defs/XsDielectric"
          },
          "title": "Dielectrics",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/XsProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the section came from; NOT part of the key."
        },
        "schema": {
          "const": "oa-xsection/1",
          "default": "oa-xsection/1",
          "description": "Schema tag; always 'oa-xsection/1'.",
          "title": "Schema",
          "type": "string"
        },
        "symmetric_about_u0": {
          "default": false,
          "description": "Geometry is mirror symmetric about u=0 (checked).",
          "title": "Symmetric About U0",
          "type": "boolean"
        },
        "topology_hint": {
          "default": "general",
          "description": "Solver hint for fast analytic paths.",
          "enum": [
            "microstrip",
            "embedded_microstrip",
            "stripline",
            "offset_stripline",
            "cpw",
            "cpwg",
            "edge_coupled_microstrip",
            "edge_coupled_stripline",
            "broadside_coupled",
            "coax",
            "wire_over_plane",
            "general"
          ],
          "title": "Topology Hint",
          "type": "string"
        }
      },
      "required": [
        "conductors",
        "dielectrics"
      ],
      "title": "CrossSection",
      "type": "object"
    },
    "DjordjevicSarkar": {
      "additionalProperties": false,
      "description": "Wideband causal Debye model defined by a single datasheet point.",
      "properties": {
        "df": {
          "description": "Loss tangent at f_ref (dimensionless).",
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Df",
          "type": "number"
        },
        "dk": {
          "description": "Relative permittivity at f_ref (dimensionless).",
          "minimum": 1.0,
          "title": "Dk",
          "type": "number"
        },
        "f_high": {
          "default": 159154943091.89536,
          "description": "Upper model corner (Hz); m2 = log10(2*pi*f_high).",
          "exclusiveMinimum": 0.0,
          "title": "F High",
          "type": "number"
        },
        "f_low": {
          "default": 1591.5494309189535,
          "description": "Lower model corner (Hz); m1 = log10(2*pi*f_low).",
          "exclusiveMinimum": 0.0,
          "title": "F Low",
          "type": "number"
        },
        "f_ref": {
          "default": 1000000000.0,
          "description": "Datasheet reference frequency, Hz.",
          "exclusiveMinimum": 0.0,
          "title": "F Ref",
          "type": "number"
        },
        "kind": {
          "const": "djordjevic_sarkar",
          "default": "djordjevic_sarkar",
          "description": "Discriminator tag; always 'djordjevic_sarkar'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dk",
        "df"
      ],
      "title": "DjordjevicSarkar",
      "type": "object"
    },
    "GeometrySample": {
      "additionalProperties": false,
      "description": "A cross-section sampled from the board geometry.",
      "properties": {
        "at_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sample point (x, y) [m].",
          "title": "At M"
        },
        "layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layer id when the net is on several.",
          "title": "Layer"
        },
        "net": {
          "description": "Net name.",
          "title": "Net",
          "type": "string"
        },
        "project_id": {
          "description": "Project id returned by board.open.",
          "title": "Project Id",
          "type": "string"
        },
        "s_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arc length along the net [m].",
          "title": "S M"
        }
      },
      "required": [
        "project_id",
        "net"
      ],
      "title": "GeometrySample",
      "type": "object"
    },
    "Groisse": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "groisse",
          "default": "groisse",
          "description": "Discriminator tag; always 'groisse'.",
          "title": "Kind",
          "type": "string"
        },
        "rq": {
          "description": "RMS roughness, metres.",
          "minimum": 0.0,
          "title": "Rq",
          "type": "number"
        }
      },
      "required": [
        "rq"
      ],
      "title": "Groisse",
      "type": "object"
    },
    "Hammerstad": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hammerstad",
          "default": "hammerstad",
          "description": "Discriminator tag; always 'hammerstad'.",
          "title": "Kind",
          "type": "string"
        },
        "rq": {
          "description": "RMS roughness, metres.",
          "minimum": 0.0,
          "title": "Rq",
          "type": "number"
        }
      },
      "required": [
        "rq"
      ],
      "title": "Hammerstad",
      "type": "object"
    },
    "Huray": {
      "additionalProperties": false,
      "properties": {
        "flat_ratio": {
          "default": 1.0,
          "description": "A_matte / A_flat (dimensionless).",
          "exclusiveMinimum": 0.0,
          "title": "Flat Ratio",
          "type": "number"
        },
        "kind": {
          "const": "huray",
          "default": "huray",
          "description": "Discriminator tag; always 'huray'.",
          "title": "Kind",
          "type": "string"
        },
        "sphere_radius": {
          "description": "Nodule sphere radius a, metres.",
          "minimum": 0.0,
          "title": "Sphere Radius",
          "type": "number"
        },
        "surface_ratio": {
          "description": "N*4*pi*a^2 / A_flat summed over one size class (dimensionless).",
          "exclusiveMinimum": 0.0,
          "title": "Surface Ratio",
          "type": "number"
        }
      },
      "required": [
        "sphere_radius",
        "surface_ratio"
      ],
      "title": "Huray",
      "type": "object"
    },
    "MultiPoleDebye": {
      "additionalProperties": false,
      "properties": {
        "eps_inf": {
          "description": "High-frequency permittivity (dimensionless).",
          "minimum": 1.0,
          "title": "Eps Inf",
          "type": "number"
        },
        "kind": {
          "const": "multipole_debye",
          "default": "multipole_debye",
          "description": "Discriminator tag; always 'multipole_debye'.",
          "title": "Kind",
          "type": "string"
        },
        "poles": {
          "description": "Pairs (delta_eps_k, f_relax_k in Hz), one per Debye pole.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "description": "Frequency in hertz, > 0. Strings such as '1GHz' parse.",
                "exclusiveMinimum": 0.0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Poles",
          "type": "array"
        },
        "sigma_dc": {
          "default": 0.0,
          "description": "DC conductivity, S/m.",
          "minimum": 0.0,
          "title": "Sigma Dc",
          "type": "number"
        }
      },
      "required": [
        "eps_inf",
        "poles"
      ],
      "title": "MultiPoleDebye",
      "type": "object"
    },
    "NoRoughness": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none",
          "default": "none",
          "description": "Discriminator tag; always 'none'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "NoRoughness",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "Simple polygon with holes. Discretized (no analytic arcs). Exterior CCW, holes CW.",
      "properties": {
        "exterior": {
          "description": "Exterior ring, counter-clockwise, not closed (first point not repeated).",
          "examples": [
            [
              0.0,
              0.0,
              0.001,
              0.0,
              0.001,
              0.001,
              0.0,
              0.001
            ]
          ],
          "items": {
            "type": "number"
          },
          "title": "Exterior",
          "type": "array"
        },
        "holes": {
          "default": [],
          "description": "Hole rings, clockwise, strictly inside the exterior.",
          "items": {
            "description": "Flat XY list in metres: [x0,y0,x1,y1,...]; even length.",
            "examples": [
              [
                0.0,
                0.0,
                0.001,
                0.0,
                0.001,
                0.001,
                0.0,
                0.001
              ]
            ],
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        }
      },
      "required": [
        "exterior"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "QuickXs": {
      "additionalProperties": false,
      "description": "Closed-form cross-section described by a topology and a few dimensions.",
      "properties": {
        "df": {
          "default": 0.0,
          "description": "Loss tangent [1].",
          "minimum": 0,
          "title": "Df",
          "type": "number"
        },
        "er": {
          "description": "Relative permittivity [1].",
          "exclusiveMinimum": 0,
          "title": "Er",
          "type": "number"
        },
        "g": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coplanar gap [m].",
          "title": "G"
        },
        "h": {
          "description": "Dielectric height to the reference [m].",
          "minimum": 0.0,
          "title": "H",
          "type": "number"
        },
        "h2": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Second dielectric height [m].",
          "title": "H2"
        },
        "mask_t": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Solder mask thickness [m].",
          "title": "Mask T"
        },
        "s": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Edge-to-edge spacing for coupled lines [m].",
          "title": "S"
        },
        "t": {
          "description": "Trace thickness [m].",
          "minimum": 0.0,
          "title": "T",
          "type": "number"
        },
        "topology": {
          "description": "Cross-section topology.",
          "enum": [
            "microstrip",
            "embedded_microstrip",
            "stripline",
            "offset_stripline",
            "cpw",
            "cpwg",
            "edge_coupled_microstrip",
            "edge_coupled_stripline"
          ],
          "title": "Topology",
          "type": "string"
        },
        "w": {
          "description": "Trace width [m]; '5mil' parses.",
          "minimum": 0.0,
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "topology",
        "w",
        "h",
        "t",
        "er"
      ],
      "title": "QuickXs",
      "type": "object"
    },
    "TableDkDf": {
      "additionalProperties": false,
      "description": "Measured/vendor table; interpolated log-f, linear Dk/Df.",
      "properties": {
        "df": {
          "description": "Loss tangent at each frequency.",
          "items": {
            "type": "number"
          },
          "title": "Df",
          "type": "array"
        },
        "dk": {
          "description": "Relative permittivity at each frequency.",
          "items": {
            "type": "number"
          },
          "title": "Dk",
          "type": "array"
        },
        "freqs": {
          "description": "Strictly increasing frequencies, Hz.",
          "items": {
            "type": "number"
          },
          "title": "Freqs",
          "type": "array"
        },
        "kind": {
          "const": "table",
          "default": "table",
          "description": "Discriminator tag; always 'table'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "freqs",
        "dk",
        "df"
      ],
      "title": "TableDkDf",
      "type": "object"
    },
    "XsCircle": {
      "additionalProperties": false,
      "description": "Analytic validation shapes (coax, wire over plane).",
      "properties": {
        "kind": {
          "const": "circle",
          "default": "circle",
          "description": "Discriminator tag; always 'circle'.",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "description": "Radius, metres.",
          "exclusiveMinimum": 0,
          "minimum": 0.0,
          "title": "Radius",
          "type": "number"
        },
        "u_center": {
          "description": "Centre u, metres.",
          "title": "U Center",
          "type": "number"
        },
        "z_center": {
          "description": "Centre z, metres.",
          "title": "Z Center",
          "type": "number"
        }
      },
      "required": [
        "u_center",
        "z_center",
        "radius"
      ],
      "title": "XsCircle",
      "type": "object"
    },
    "XsConductor": {
      "additionalProperties": false,
      "properties": {
        "conductivity": {
          "default": 58000000.0,
          "description": "Conductivity, S/m.",
          "exclusiveMinimum": 0,
          "title": "Conductivity",
          "type": "number"
        },
        "id": {
          "description": "'s1', 's2', 'g1', ...: unique in the section.",
          "title": "Id",
          "type": "string"
        },
        "net": {
          "anyOf": [
            {
              "description": "Net name, unique per board (the net's key). Never an index.",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provenance only; NOT part of the key.",
          "title": "Net"
        },
        "role": {
          "description": "Electrical role.",
          "enum": [
            "signal",
            "ground",
            "floating"
          ],
          "title": "Role",
          "type": "string"
        },
        "roughness_bottom": {
          "default": {
            "kind": "none"
          },
          "description": "Bottom surface roughness.",
          "discriminator": {
            "mapping": {
              "cannonball_huray": "#/$defs/CannonballHuray",
              "groisse": "#/$defs/Groisse",
              "hammerstad": "#/$defs/Hammerstad",
              "huray": "#/$defs/Huray",
              "none": "#/$defs/NoRoughness"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoRoughness"
            },
            {
              "$ref": "#/$defs/Hammerstad"
            },
            {
              "$ref": "#/$defs/Groisse"
            },
            {
              "$ref": "#/$defs/Huray"
            },
            {
              "$ref": "#/$defs/CannonballHuray"
            }
          ],
          "title": "Roughness Bottom"
        },
        "roughness_side": {
          "default": {
            "kind": "none"
          },
          "description": "Sidewall roughness.",
          "discriminator": {
            "mapping": {
              "cannonball_huray": "#/$defs/CannonballHuray",
              "groisse": "#/$defs/Groisse",
              "hammerstad": "#/$defs/Hammerstad",
              "huray": "#/$defs/Huray",
              "none": "#/$defs/NoRoughness"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoRoughness"
            },
            {
              "$ref": "#/$defs/Hammerstad"
            },
            {
              "$ref": "#/$defs/Groisse"
            },
            {
              "$ref": "#/$defs/Huray"
            },
            {
              "$ref": "#/$defs/CannonballHuray"
            }
          ],
          "title": "Roughness Side"
        },
        "roughness_top": {
          "default": {
            "kind": "none"
          },
          "description": "Top surface roughness.",
          "discriminator": {
            "mapping": {
              "cannonball_huray": "#/$defs/CannonballHuray",
              "groisse": "#/$defs/Groisse",
              "hammerstad": "#/$defs/Hammerstad",
              "huray": "#/$defs/Huray",
              "none": "#/$defs/NoRoughness"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoRoughness"
            },
            {
              "$ref": "#/$defs/Hammerstad"
            },
            {
              "$ref": "#/$defs/Groisse"
            },
            {
              "$ref": "#/$defs/Huray"
            },
            {
              "$ref": "#/$defs/CannonballHuray"
            }
          ],
          "title": "Roughness Top"
        },
        "shape": {
          "description": "Conductor geometry.",
          "discriminator": {
            "mapping": {
              "circle": "#/$defs/XsCircle",
              "plane": "#/$defs/XsPlane",
              "polygon": "#/$defs/XsPolygon",
              "trapezoid": "#/$defs/XsTrapezoid"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/XsTrapezoid"
            },
            {
              "$ref": "#/$defs/XsPolygon"
            },
            {
              "$ref": "#/$defs/XsCircle"
            },
            {
              "$ref": "#/$defs/XsPlane"
            }
          ],
          "title": "Shape"
        }
      },
      "required": [
        "id",
        "role",
        "shape"
      ],
      "title": "XsConductor",
      "type": "object"
    },
    "XsDielectric": {
      "additionalProperties": false,
      "properties": {
        "dk_z_over_dk_xy": {
          "default": 1.0,
          "description": "Anisotropy ratio.",
          "exclusiveMinimum": 0,
          "title": "Dk Z Over Dk Xy",
          "type": "number"
        },
        "model": {
          "description": "Frequency-dependent Dk/Df model.",
          "discriminator": {
            "mapping": {
              "constant": "#/$defs/ConstantDkDf",
              "djordjevic_sarkar": "#/$defs/DjordjevicSarkar",
              "multipole_debye": "#/$defs/MultiPoleDebye",
              "table": "#/$defs/TableDkDf"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstantDkDf"
            },
            {
              "$ref": "#/$defs/DjordjevicSarkar"
            },
            {
              "$ref": "#/$defs/MultiPoleDebye"
            },
            {
              "$ref": "#/$defs/TableDkDf"
            }
          ],
          "title": "Model"
        },
        "priority": {
          "default": 0,
          "description": "Higher wins where regions overlap; slabs 0, regions 10.",
          "title": "Priority",
          "type": "integer"
        },
        "region": {
          "description": "Where this dielectric is.",
          "discriminator": {
            "mapping": {
              "region": "#/$defs/XsRegion",
              "slab": "#/$defs/XsSlab"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/XsSlab"
            },
            {
              "$ref": "#/$defs/XsRegion"
            }
          ],
          "title": "Region"
        }
      },
      "required": [
        "region",
        "model"
