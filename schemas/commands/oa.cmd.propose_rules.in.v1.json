{
  "$defs": {
    "AssignNetclassChange": {
      "additionalProperties": false,
      "description": "Assign nets (glob patterns) to a net class in the `.kicad_pro`.",
      "properties": {
        "kind": {
          "const": "assign_netclass",
          "description": "Discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "netclass": {
          "description": "Existing net class name.",
          "title": "Netclass",
          "type": "string"
        },
        "nets": {
          "description": "Net name glob patterns.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Nets",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "nets",
        "netclass"
      ],
      "title": "AssignNetclassChange",
      "type": "object"
    },
    "CustomRuleChange": {
      "additionalProperties": false,
      "description": "Add a custom rule to the `.kicad_dru` (an existing rule of the same name is replaced).",
      "properties": {
        "condition": {
          "description": "KiCad rule condition, e.g. \"A.NetClass == 'HS'\".",
          "title": "Condition",
          "type": "string"
        },
        "constraint": {
          "description": "KiCad constraint type.",
          "enum": [
            "clearance",
            "track_width",
            "length",
            "skew",
            "via_count",
            "diff_pair_gap",
            "diff_pair_uncoupled",
            "edge_clearance",
            "hole_clearance",
            "courtyard_clearance"
          ],
          "title": "Constraint",
          "type": "string"
        },
        "kind": {
          "const": "custom_rule",
          "description": "Discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict the rule to one layer name.",
          "title": "Layer"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum: SI float [m or s] or string.",
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum: SI float [m or s] or string.",
          "title": "Min"
        },
        "name": {
          "description": "Rule name, unique in the file.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "opt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optimum: SI float [m or s] or string.",
          "title": "Opt"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "error",
                "warning",
                "ignore"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Severity of violations of this rule.",
          "title": "Severity"
        }
      },
      "required": [
        "kind",
        "name",
        "condition",
        "constraint"
      ],
      "title": "CustomRuleChange",
      "type": "object"
    },
    "FromViolations": {
      "additionalProperties": false,
      "description": "Violations whose rule/netclass remediation actions become changes.",
      "properties": {
        "fingerprints": {
          "default": [],
          "description": "Violation fingerprints; empty means every non-waived violation.",
          "items": {
            "type": "string"
          },
          "title": "Fingerprints",
          "type": "array"
        },
        "result_id": {
          "description": "Result id holding the violations.",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "result_id"
      ],
      "title": "FromViolations",
      "type": "object"
    },
    "NetclassParamChange": {
      "additionalProperties": false,
      "description": "Set one parameter of a net class in the `.kicad_pro`.",
      "properties": {
        "kind": {
          "const": "netclass_param",
          "description": "Discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "netclass": {
          "description": "Existing net class name.",
          "title": "Netclass",
          "type": "string"
        },
        "param": {
          "description": "Which net class parameter to set.",
          "enum": [
            "clearance",
            "track_width",
            "diff_pair_width",
            "diff_pair_gap",
            "via_diameter",
            "via_drill"
          ],
          "title": "Param",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "New value: SI float [m] or a string such as '0.2mm'.",
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "netclass",
        "param",
        "value"
      ],
      "title": "NetclassParamChange",
      "type": "object"
    },
    "RemoveCustomRuleChange": {
      "additionalProperties": false,
      "description": "Remove a custom rule from the `.kicad_dru`.",
      "properties": {
        "kind": {
          "const": "remove_custom_rule",
          "description": "Discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Name of the rule to remove.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "RemoveCustomRuleChange",
      "type": "object"
    }
  },
  "$id": "oa.cmd.propose_rules.in/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compute a diff for `.kicad_dru` / `.kicad_pro` changes. Never writes user files.",
  "properties": {
    "changes": {
      "default": [],
      "description": "Explicit changes.",
      "items": {
        "discriminator": {
          "mapping": {
            "assign_netclass": "#/$defs/AssignNetclassChange",
            "custom_rule": "#/$defs/CustomRuleChange",
            "netclass_param": "#/$defs/NetclassParamChange",
            "remove_custom_rule": "#/$defs/RemoveCustomRuleChange"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NetclassParamChange"
          },
          {
            "$ref": "#/$defs/AssignNetclassChange"
          },
          {
            "$ref": "#/$defs/CustomRuleChange"
          },
          {
            "$ref": "#/$defs/RemoveCustomRuleChange"
          }
        ]
      },
      "title": "Changes",
      "type": "array"
    },
    "from_violations": {
      "anyOf": [
        {
          "$ref": "#/$defs/FromViolations"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Derive changes from violation remediations."
    },
    "project_id": {
      "description": "Project id from open_board.",
      "title": "Project Id",
      "type": "string"
    },
    "target": {
      "default": "auto",
      "description": "Restrict the proposal to one file kind.",
      "enum": [
        "kicad_dru",
        "kicad_pro_netclasses",
        "auto"
      ],
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "ProposeIn",
  "type": "object"
}
