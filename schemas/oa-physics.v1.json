{
  "$comment": "SPDX-License-Identifier: CC-BY-4.0. Generated by 'python -m oa_model.schemas'.",
  "$defs": {
    "CannonballHuray": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cannonball_huray",
          "default": "cannonball_huray",
          "description": "Discriminator tag; always 'cannonball_huray'.",
          "title": "Kind",
          "type": "string"
        },
        "rz": {
          "description": "Datasheet Rz (10-point height), metres.",
          "minimum": 0.0,
          "title": "Rz",
          "type": "number"
        }
      },
      "required": [
        "rz"
      ],
      "title": "CannonballHuray",
      "type": "object"
    },
    "ConductorMaterial": {
      "additionalProperties": false,
      "properties": {
        "conductivity": {
          "default": 58000000.0,
          "description": "Conductivity at t_ref, S/m.",
          "exclusiveMinimum": 0.0,
          "title": "Conductivity",
          "type": "number"
        },
        "kind": {
          "const": "conductor",
          "default": "conductor",
          "description": "Discriminator tag; always 'conductor'.",
          "title": "Kind",
          "type": "string"
        },
        "mu_r": {
          "default": 1.0,
          "description": "Relative permeability (dimensionless).",
          "exclusiveMinimum": 0.0,
          "title": "Mu R",
          "type": "number"
        },
        "name": {
          "description": "Material key, e.g. 'copper_ed'.",
          "examples": [
            "copper_ed"
          ],
          "title": "Name",
          "type": "string"
        },
        "source": {
          "default": "default",
          "description": "Where this material definition came from.",
          "enum": [
            "ingest",
            "sidecar",
            "library",
            "default"
          ],
          "title": "Source",
          "type": "string"
        },
        "t_ref": {
          "default": 293.15,
          "description": "Reference temperature for conductivity, K.",
          "title": "T Ref",
          "type": "number"
        },
        "temp_coeff": {
          "default": 0.00393,
          "description": "Resistivity temperature coefficient, 1/K: rho(T)=rho0(1+a(T-t_ref)).",
          "title": "Temp Coeff",
          "type": "number"
        },
        "thermal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThermalProps"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "density": null,
            "emissivity": null,
            "k_xy": 390.0,
            "k_z": 390.0,
            "specific_heat": null
          },
          "description": "Thermal properties."
        }
      },
      "required": [
        "name"
      ],
      "title": "ConductorMaterial",
      "type": "object"
    },
    "ConstantDkDf": {
      "additionalProperties": false,
      "description": "Constant Dk/Df at f_ref. NOT causal; physics converts it to Djordjevic-Sarkar.",
      "properties": {
        "df": {
          "description": "Loss tangent (dimensionless).",
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Df",
          "type": "number"
        },
        "dk": {
          "description": "Relative permittivity (dimensionless), >= 1.",
          "minimum": 1.0,
          "title": "Dk",
          "type": "number"
        },
        "f_ref": {
          "default": 1000000000.0,
          "description": "Frequency (Hz) at which dk/df were measured.",
          "exclusiveMinimum": 0.0,
          "title": "F Ref",
          "type": "number"
        },
        "kind": {
          "const": "constant",
          "default": "constant",
          "description": "Discriminator tag; always 'constant'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dk",
        "df"
      ],
      "title": "ConstantDkDf",
      "type": "object"
    },
    "DielectricMaterial": {
      "additionalProperties": false,
      "properties": {
        "dk_z_over_dk_xy": {
          "default": 1.0,
          "description": "Anisotropy ratio Dk_z / Dk_xy; 1.0 means isotropic.",
          "exclusiveMinimum": 0.0,
          "title": "Dk Z Over Dk Xy",
          "type": "number"
        },
        "kind": {
          "const": "dielectric",
          "default": "dielectric",
          "description": "Discriminator tag; always 'dielectric'.",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "description": "Frequency-dependent Dk/Df model.",
          "discriminator": {
            "mapping": {
              "constant": "#/$defs/ConstantDkDf",
              "djordjevic_sarkar": "#/$defs/DjordjevicSarkar",
              "multipole_debye": "#/$defs/MultiPoleDebye",
              "table": "#/$defs/TableDkDf"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstantDkDf"
            },
            {
              "$ref": "#/$defs/DjordjevicSarkar"
            },
            {
              "$ref": "#/$defs/MultiPoleDebye"
            },
            {
              "$ref": "#/$defs/TableDkDf"
            }
          ],
          "title": "Model"
        },
        "name": {
          "description": "Material key referenced by stack layers.",
          "examples": [
            "FR4_generic"
          ],
          "title": "Name",
          "type": "string"
        },
        "source": {
          "default": "ingest",
          "description": "Where this material definition came from.",
          "enum": [
            "ingest",
            "sidecar",
            "library",
            "default"
          ],
          "title": "Source",
          "type": "string"
        },
        "thermal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThermalProps"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thermal properties, if known."
        }
      },
      "required": [
        "name",
        "model"
      ],
      "title": "DielectricMaterial",
      "type": "object"
    },
    "DjordjevicSarkar": {
      "additionalProperties": false,
      "description": "Wideband causal Debye model defined by a single datasheet point.",
      "properties": {
        "df": {
          "description": "Loss tangent at f_ref (dimensionless).",
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Df",
          "type": "number"
        },
        "dk": {
          "description": "Relative permittivity at f_ref (dimensionless).",
          "minimum": 1.0,
          "title": "Dk",
          "type": "number"
        },
        "f_high": {
          "default": 159154943091.89536,
          "description": "Upper model corner (Hz); m2 = log10(2*pi*f_high).",
          "exclusiveMinimum": 0.0,
          "title": "F High",
          "type": "number"
        },
        "f_low": {
          "default": 1591.5494309189535,
          "description": "Lower model corner (Hz); m1 = log10(2*pi*f_low).",
          "exclusiveMinimum": 0.0,
          "title": "F Low",
          "type": "number"
        },
        "f_ref": {
          "default": 1000000000.0,
          "description": "Datasheet reference frequency, Hz.",
          "exclusiveMinimum": 0.0,
          "title": "F Ref",
          "type": "number"
        },
        "kind": {
          "const": "djordjevic_sarkar",
          "default": "djordjevic_sarkar",
          "description": "Discriminator tag; always 'djordjevic_sarkar'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dk",
        "df"
      ],
      "title": "DjordjevicSarkar",
      "type": "object"
    },
    "Etch": {
      "additionalProperties": false,
      "description": "Trapezoidal trace cross-section. Both forms are allowed; physics normalizes them.",
      "properties": {
        "kind": {
          "description": "'angle': value is the etch angle; 'top_width_delta': value is w_bottom - w_top.",
          "enum": [
            "angle",
            "top_width_delta"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "default": "bottom",
          "description": "Which width the drawn track width denotes.",
          "enum": [
            "bottom",
            "top"
          ],
          "title": "Reference",
          "type": "string"
        },
        "value": {
          "description": "kind='angle': radians from the base (pi/2 = vertical walls; '60deg' parses). kind='top_width_delta': metres, (w_bottom - w_top).",
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Etch",
      "type": "object"
    },
    "Groisse": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "groisse",
          "default": "groisse",
          "description": "Discriminator tag; always 'groisse'.",
          "title": "Kind",
          "type": "string"
        },
        "rq": {
          "description": "RMS roughness, metres.",
          "minimum": 0.0,
          "title": "Rq",
          "type": "number"
        }
      },
      "required": [
        "rq"
      ],
      "title": "Groisse",
      "type": "object"
    },
    "Hammerstad": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hammerstad",
          "default": "hammerstad",
          "description": "Discriminator tag; always 'hammerstad'.",
          "title": "Kind",
          "type": "string"
        },
        "rq": {
          "description": "RMS roughness, metres.",
          "minimum": 0.0,
          "title": "Rq",
          "type": "number"
        }
      },
      "required": [
        "rq"
      ],
      "title": "Hammerstad",
      "type": "object"
    },
    "Huray": {
      "additionalProperties": false,
      "properties": {
        "flat_ratio": {
          "default": 1.0,
          "description": "A_matte / A_flat (dimensionless).",
          "exclusiveMinimum": 0.0,
          "title": "Flat Ratio",
          "type": "number"
        },
        "kind": {
          "const": "huray",
          "default": "huray",
          "description": "Discriminator tag; always 'huray'.",
          "title": "Kind",
          "type": "string"
        },
        "sphere_radius": {
          "description": "Nodule sphere radius a, metres.",
          "minimum": 0.0,
          "title": "Sphere Radius",
          "type": "number"
        },
        "surface_ratio": {
          "description": "N*4*pi*a^2 / A_flat summed over one size class (dimensionless).",
          "exclusiveMinimum": 0.0,
          "title": "Surface Ratio",
          "type": "number"
        }
      },
      "required": [
        "sphere_radius",
        "surface_ratio"
      ],
      "title": "Huray",
      "type": "object"
    },
    "LayerOverride": {
      "additionalProperties": false,
      "properties": {
        "construction": {
          "anyOf": [
            {
              "enum": [
                "core",
                "prepreg"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dielectric layers only.",
          "title": "Construction"
        },
        "etch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Etch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conductor layers only."
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replace the material reference.",
          "title": "Material"
        },
        "plating_thickness": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conductor layers only.",
          "title": "Plating Thickness"
        },
        "roughness_bottom": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cannonball_huray": "#/$defs/CannonballHuray",
                  "groisse": "#/$defs/Groisse",
                  "hammerstad": "#/$defs/Hammerstad",
                  "huray": "#/$defs/Huray",
                  "none": "#/$defs/NoRoughness"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/NoRoughness"
                },
                {
                  "$ref": "#/$defs/Hammerstad"
                },
                {
                  "$ref": "#/$defs/Groisse"
                },
                {
                  "$ref": "#/$defs/Huray"
                },
                {
                  "$ref": "#/$defs/CannonballHuray"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conductor layers only.",
          "title": "Roughness Bottom"
        },
        "roughness_side": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cannonball_huray": "#/$defs/CannonballHuray",
                  "groisse": "#/$defs/Groisse",
                  "hammerstad": "#/$defs/Hammerstad",
                  "huray": "#/$defs/Huray",
                  "none": "#/$defs/NoRoughness"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/NoRoughness"
                },
                {
                  "$ref": "#/$defs/Hammerstad"
                },
                {
                  "$ref": "#/$defs/Groisse"
                },
                {
                  "$ref": "#/$defs/Huray"
                },
                {
                  "$ref": "#/$defs/CannonballHuray"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conductor layers only.",
          "title": "Roughness Side"
        },
        "roughness_top": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cannonball_huray": "#/$defs/CannonballHuray",
                  "groisse": "#/$defs/Groisse",
                  "hammerstad": "#/$defs/Hammerstad",
                  "huray": "#/$defs/Huray",
                  "none": "#/$defs/NoRoughness"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/NoRoughness"
                },
                {
                  "$ref": "#/$defs/Hammerstad"
                },
                {
                  "$ref": "#/$defs/Groisse"
                },
                {
                  "$ref": "#/$defs/Huray"
                },
                {
                  "$ref": "#/$defs/CannonballHuray"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conductor layers only.",
          "title": "Roughness Top"
        },
        "select": {
          "$ref": "#/$defs/LayerSelector",
          "description": "Which layers this override applies to."
        },
        "thickness": {
          "anyOf": [
            {
              "description": "Length in metres, >= 0. Strings such as '5mil' or '0.2mm' parse.",
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thickness in metres; z is recomputed for the whole stack.",
          "title": "Thickness"
        }
      },
      "required": [
        "select"
      ],
      "title": "LayerOverride",
      "type": "object"
    },
    "LayerSelector": {
      "additionalProperties": false,
      "description": "Selects stack layers by id ('L3'), source name ('In2.Cu'), kind or glob. A layer matches\nwhen ANY criterion matches; at least one criterion is required.",
      "properties": {
        "ids": {
          "default": [],
          "description": "Layer ids or globs: 'L3', 'L*'.",
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "kinds": {
          "default": [],
          "description": "Layer kinds.",
          "items": {
            "enum": [
              "conductor",
              "dielectric",
              "mask"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "source_names": {
          "default": [],
          "description": "Source layer names or globs: 'In2.Cu', '*.Cu'.",
          "items": {
            "type": "string"
          },
          "title": "Source Names",
          "type": "array"
        }
      },
      "title": "LayerSelector",
      "type": "object"
    },
    "MaterialAlias": {
      "additionalProperties": false,
      "description": "Maps a source material name ('FR4', '2116 RC58%') to a library or sidecar material.",
      "properties": {
        "material": {
          "description": "Name of the replacement material.",
          "title": "Material",
          "type": "string"
        },
        "source_name": {
          "description": "Material name as found in the board.",
          "title": "Source Name",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "material"
      ],
      "title": "MaterialAlias",
      "type": "object"
    },
    "MultiPoleDebye": {
      "additionalProperties": false,
      "properties": {
        "eps_inf": {
          "description": "High-frequency permittivity (dimensionless).",
          "minimum": 1.0,
          "title": "Eps Inf",
          "type": "number"
        },
        "kind": {
          "const": "multipole_debye",
          "default": "multipole_debye",
          "description": "Discriminator tag; always 'multipole_debye'.",
          "title": "Kind",
          "type": "string"
        },
        "poles": {
          "description": "Pairs (delta_eps_k, f_relax_k in Hz), one per Debye pole.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "description": "Frequency in hertz, > 0. Strings such as '1GHz' parse.",
                "exclusiveMinimum": 0.0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Poles",
          "type": "array"
        },
        "sigma_dc": {
          "default": 0.0,
          "description": "DC conductivity, S/m.",
          "minimum": 0.0,
          "title": "Sigma Dc",
          "type": "number"
        }
      },
      "required": [
        "eps_inf",
        "poles"
      ],
      "title": "MultiPoleDebye",
      "type": "object"
    },
    "NoRoughness": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none",
          "default": "none",
          "description": "Discriminator tag; always 'none'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "NoRoughness",
      "type": "object"
    },
    "PhysicsDefaults": {
      "additionalProperties": false,
      "properties": {
        "conductor_material": {
          "default": "copper",
          "description": "Material for conductor layers whose material came from ingest/defaults.",
          "title": "Conductor Material",
          "type": "string"
        },
        "dielectric_model_upgrade": {
          "default": "djordjevic_sarkar",
          "description": "'djordjevic_sarkar': every ConstantDkDf left after aliasing becomes DS.",
          "enum": [
            "none",
            "djordjevic_sarkar"
          ],
          "title": "Dielectric Model Upgrade",
          "type": "string"
        },
        "roughness": {
          "default": {
            "kind": "none"
          },
          "description": "Roughness for conductor surfaces that have none.",
          "discriminator": {
            "mapping": {
              "cannonball_huray": "#/$defs/CannonballHuray",
              "groisse": "#/$defs/Groisse",
              "hammerstad": "#/$defs/Hammerstad",
              "huray": "#/$defs/Huray",
              "none": "#/$defs/NoRoughness"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NoRoughness"
            },
            {
              "$ref": "#/$defs/Hammerstad"
            },
            {
              "$ref": "#/$defs/Groisse"
            },
            {
              "$ref": "#/$defs/Huray"
            },
            {
              "$ref": "#/$defs/CannonballHuray"
            }
          ],
          "title": "Roughness"
        }
      },
      "title": "PhysicsDefaults",
      "type": "object"
    },
    "TableDkDf": {
      "additionalProperties": false,
      "description": "Measured/vendor table; interpolated log-f, linear Dk/Df.",
      "properties": {
        "df": {
          "description": "Loss tangent at each frequency.",
          "items": {
            "type": "number"
          },
          "title": "Df",
          "type": "array"
        },
        "dk": {
          "description": "Relative permittivity at each frequency.",
          "items": {
            "type": "number"
          },
          "title": "Dk",
          "type": "array"
        },
        "freqs": {
          "description": "Strictly increasing frequencies, Hz.",
          "items": {
            "type": "number"
          },
          "title": "Freqs",
          "type": "array"
        },
        "kind": {
          "const": "table",
          "default": "table",
          "description": "Discriminator tag; always 'table'.",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "freqs",
        "dk",
        "df"
      ],
      "title": "TableDkDf",
      "type": "object"
    },
    "ThermalProps": {
      "additionalProperties": false,
      "description": "Bulk thermal properties, anisotropic: in-plane (xy) and through-plane (z).",
      "properties": {
        "density": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Density, kg/m^3.",
          "title": "Density"
        },
        "emissivity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Surface emissivity (0..1), mask surfaces.",
          "title": "Emissivity"
        },
        "k_xy": {
          "description": "In-plane thermal conductivity, W/(m K).",
          "exclusiveMinimum": 0.0,
          "title": "K Xy",
          "type": "number"
        },
        "k_z": {
          "description": "Through-plane thermal conductivity, W/(m K).",
          "exclusiveMinimum": 0.0,
          "title": "K Z",
          "type": "number"
        },
        "specific_heat": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific heat, J/(kg K).",
          "title": "Specific Heat"
        }
      },
      "required": [
        "k_xy",
        "k_z"
      ],
      "title": "ThermalProps",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "default": [],
      "description": "Material renames.",
      "items": {
        "$ref": "#/$defs/MaterialAlias"
      },
      "title": "Aliases",
      "type": "array"
    },
    "defaults": {
