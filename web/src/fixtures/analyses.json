 },
 {
  "config_schema": {
   "$defs": {
    "LimitsConfig": {
     "additionalProperties": false,
     "properties": {
      "drop_fraction": {
       "default": 0.03,
       "description": "Allowed load drop as a fraction of vset [1].",
       "exclusiveMaximum": 1.0,
       "exclusiveMinimum": 0.0,
       "title": "Drop Fraction",
       "type": "number"
      },
      "via_current_density": {
       "default": 300000000.0,
       "description": "Allowed via barrel current density [A/m^2].",
       "exclusiveMinimum": 0.0,
       "title": "Via Current Density",
       "type": "number"
      }
     },
     "title": "LimitsConfig",
     "type": "object"
    },
    "LoadConfig": {
     "additionalProperties": false,
     "properties": {
      "component": {
       "description": "Refdes of the load component (IC, connector).",
       "title": "Component",
       "type": "string"
      },
      "current": {
       "description": "Total load current [A], drawn from the rail pins.",
       "title": "Current",
       "type": "number"
      },
      "model": {
       "default": "pin_group",
       "description": "'pin_group': all pins are one equipotential node and the copper decides the split (default). 'equal_split': every pin draws current/N independently.",
       "enum": [
        "pin_group",
        "equal_split"
       ],
       "title": "Model",
       "type": "string"
      },
      "name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Display name; defaults to the refdes.",
       "title": "Name"
      },
      "nets": {
       "default": [],
       "description": "Nets drawing the current; the first must be the rail net. Empty = the rail.",
       "items": {
        "description": "Net name, unique per board (the net's key). Never an index.",
        "minLength": 1,
        "type": "string"
       },
       "title": "Nets",
       "type": "array"
      },
      "pins": {
       "default": [],
       "description": "Pin numbers on the rail net; empty = every pin on the rail net.",
       "items": {
        "type": "string"
       },
       "title": "Pins",
       "type": "array"
      },
      "return_pins": {
       "default": [],
       "description": "Pin numbers on the return net; empty = every pin on it.",
       "items": {
        "type": "string"
       },
       "title": "Return Pins",
       "type": "array"
      }
     },
     "required": [
      "component",
      "current"
     ],
     "title": "LoadConfig",
     "type": "object"
    },
    "MeshConfig": {
     "additionalProperties": false,
     "properties": {
      "h_plane": {
       "default": 0.0008,
       "description": "Target element edge in copper areas [m].",
       "exclusiveMinimum": 0.0,
       "minimum": 0.0,
       "title": "H Plane",
       "type": "number"
      },
      "h_trace_factor": {
       "default": 0.33,
       "description": "Element edge along tracks as a fraction of the track width [1].",
       "exclusiveMinimum": 0.0,
       "maximum": 1.0,
       "title": "H Trace Factor",
       "type": "number"
      },
      "solver": {
       "default": "auto",
       "description": "Linear solver. 'auto': PARDISO or CHOLMOD when installed, else SuperLU; AMG-PCG above 1 million unknowns.",
       "enum": [
        "auto",
        "superlu",
        "pardiso",
        "cholmod",
        "amg"
       ],
       "title": "Solver",
       "type": "string"
      },
      "via_ring_segments": {
       "default": 16,
       "description": "Mesh nodes around every via/pad contact ring [1].",
       "maximum": 256,
       "minimum": 8,
       "title": "Via Ring Segments",
       "type": "integer"
      }
     },
     "title": "MeshConfig",
     "type": "object"
    },
    "RailConfig": {
     "additionalProperties": false,
     "properties": {
      "net": {
       "description": "Supply net whose copper carries the load current.",
       "minLength": 1,
       "title": "Net",
       "type": "string"
      },
      "return": {
       "anyOf": [
        {
         "description": "Net name, unique per board (the net's key). Never an index.",
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Return (ground) net, solved together with the rail. None = ideal lossless return: the drop is then the rail copper only.",
       "title": "Return"
      }
     },
     "required": [
      "net"
     ],
     "title": "RailConfig",
     "type": "object"
    },
    "SenseConfig": {
     "additionalProperties": false,
     "properties": {
      "neg": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Remote-sense pin on the return net, 'REFDES.PIN'. None = sense to ground.",
       "title": "Neg"
      },
      "pos": {
       "description": "Remote-sense pin on the rail net, 'REFDES.PIN' (e.g. 'U1.AA12').",
       "title": "Pos",
       "type": "string"
      }
     },
     "required": [
      "pos"
     ],
     "title": "SenseConfig",
     "type": "object"
    },
    "VrmConfig": {
     "additionalProperties": false,
     "properties": {
      "component": {
       "description": "Refdes of the regulator (or connector) feeding the rail.",
       "title": "Component",
       "type": "string"
      },
      "pins": {
       "default": [],
       "description": "Output pin numbers on the rail net; empty = every pin of the component on it.",
       "items": {
        "type": "string"
       },
       "title": "Pins",
       "type": "array"
      },
      "r_out": {
       "default": 0.0,
       "description": "Thevenin output resistance of the regulator [ohm].",
       "minimum": 0.0,
       "title": "R Out",
       "type": "number"
      },
      "return_pins": {
       "default": [],
       "description": "Return pin numbers on the return net; empty = every pin on the return net.",
       "items": {
        "type": "string"
       },
       "title": "Return Pins",
       "type": "array"
      },
      "sense": {
       "anyOf": [
        {
         "$ref": "#/$defs/SenseConfig"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Remote sense: the regulator adjusts its output so the sensed voltage is vset."
      },
      "vset": {
       "default": 1.0,
       "description": "Regulated output voltage [V] (between output and return pins).",
       "title": "Vset",
       "type": "number"
      }
     },
     "required": [
      "component"
     ],
     "title": "VrmConfig",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "limits": {
     "$ref": "#/$defs/LimitsConfig",
     "default": {
      "drop_fraction": 0.03,
      "via_current_density": 300000000.0
     },
     "description": "Pass/fail limits."
    },
    "loads": {
     "description": "Current sinks.",
     "items": {
      "$ref": "#/$defs/LoadConfig"
     },
     "minItems": 1,
     "title": "Loads",
     "type": "array"
    },
    "mesh": {
     "$ref": "#/$defs/MeshConfig",
     "default": {
      "h_plane": 0.0008,
      "h_trace_factor": 0.33,
      "solver": "auto",
      "via_ring_segments": 16
     },
     "description": "Meshing and solver controls."
    },
    "rail": {
     "$ref": "#/$defs/RailConfig",
     "description": "Supply and return nets."
    },
    "temperature": {
     "default": 298.15,
     "description": "Uniform copper temperature [K]. Strings such as '25degC' parse.",
     "title": "Temperature",
     "type": "number"
    },
    "vrm": {
     "$ref": "#/$defs/VrmConfig",
     "description": "The regulator (Dirichlet source)."
    }
   },
   "required": [
    "rail",
    "vrm",
    "loads"
   ],
   "title": "DcConfig",
   "type": "object"
  },
  "kind": "pi.dc",
  "title": "DC IR drop",
  "version": "1"
 }
